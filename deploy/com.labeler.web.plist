<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for the shared VC-500W label server on munchlax. pokeflute's
  install-launchd-daemon.sh converts this into a system LaunchDaemon (survives
  headless reboots). The launcher (run-labeler-web.sh) starts waitress on
  0.0.0.0:5001 and loads the port from ~/.labeler/env.
  Port 5001, NOT 5000: macOS AirPlay owns 5000 & 7000 (see D:\hw\docs\munchlax-ports.md).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.labeler.web</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/mike/projects/labeler-vc500w/deploy/run-labeler-web.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>/Users/mike/projects/labeler-vc500w</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/mike/.labeler/labeler-web.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mike/.labeler/labeler-web.log</string>
</dict>
</plist>
